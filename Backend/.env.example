# TiDB Cloud Starter (MySQL-compatible public endpoint)
# Use the complete prefixed username shown in TiDB's Connect dialog.
MYSQL_USER=instance_prefix.root
MYSQL_PASSWORD=replace-with-tidb-password
MYSQL_HOST=gateway01.<region>.prod.aws.tidbcloud.com
MYSQL_PORT=4000
# Use an application database such as test or trustsphere, not sys.
MYSQL_DB=test
MYSQL_SSL=true
# Optional when the runtime does not expose its system CA bundle.
# MYSQL_SSL_CA=/etc/ssl/certs/ca-certificates.crt

JWT_SECRET_KEY=replace-with-a-long-random-secret
MAIL_SERVER=smtp.gmail.com
MAIL_USERNAME=replace-with-smtp-account
MAIL_PASSWORD=replace-with-smtp-app-password
CLOUDINARY_CLOUD_NAME=replace-with-cloudinary-name
CLOUDINARY_API_KEY=replace-with-cloudinary-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-secret
SUPPORT_EMAIL=replace-with-support-recipient
